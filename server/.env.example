PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devhub_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_REFRESH_EXPIRE=7d

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Mỗi thông báo trong hệ thống (giao việc, đổi trạng thái, duyệt/yêu cầu sửa...) đều kèm email cho người nhận.
# Đặt true để tạm tắt việc gửi email (vẫn có thông báo trong hệ thống), vd. khi chạy thử với dữ liệu mẫu.
EMAIL_DISABLED=false

# Client URL
CLIENT_URL=http://localhost:5173
