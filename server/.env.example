PORT=5000
NODE_ENV=development

# PostgreSQL — chạy ở máy: điền DB_*. Deploy (Railway): chỉ cần DATABASE_URL=${{Postgres.DATABASE_URL}} (có thì dùng DATABASE_URL, bỏ qua DB_*)
DATABASE_URL=
# Đặt true nếu cơ sở dữ liệu bắt buộc SSL (kết nối qua địa chỉ công khai). Mạng nội bộ của Railway không cần.
DB_SSL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devhub_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_REFRESH_EXPIRE=7d

# Email — chọn MỘT trong hai cách:
#  1) Deploy trên Railway (SMTP bị chặn ở gói không Pro): dùng API HTTPS của Brevo
#     BREVO_API_KEY = khóa API lấy ở brevo.com; EMAIL_FROM = địa chỉ gửi ĐÃ XÁC MINH ở Brevo (mục Senders)
BREVO_API_KEY=
EMAIL_FROM=
#  2) Chạy ở máy: Gmail SMTP (không đặt BREVO_API_KEY)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Mỗi thông báo trong hệ thống (giao việc, đổi trạng thái, duyệt/yêu cầu sửa...) đều kèm email cho người nhận.
# Đặt true để tạm tắt việc gửi email (vẫn có thông báo trong hệ thống), vd. khi chạy thử với dữ liệu mẫu.
EMAIL_DISABLED=false

# Địa chỉ website (dùng cho liên kết trong email). Deploy: https://<tên-miền-railway>. Máy chủ phục vụ luôn giao diện khi NODE_ENV=production
# (hoặc đặt SERVE_CLIENT=true để thử bản build ở máy: build client rồi chạy server)
SERVE_CLIENT=
CLIENT_URL=http://localhost:5173

# Đăng nhập bằng Google: GOOGLE_CLIENT_ID (máy chủ kiểm tra token) và VITE_GOOGLE_CLIENT_ID (giao diện hiện nút) là CÙNG một Client ID.
# Thiếu GOOGLE_CLIENT_ID thì máy chủ từ chối đăng nhập Google. Trên Railway, VITE_GOOGLE_CLIENT_ID phải có trước khi build giao diện.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Google Gemini (loc ky nang tu CV, de trong thi bo qua)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
